{
  "expo": {
    "name": "Dara",
    "slug": "daram-finance",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.hooman.finance",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "REQUEST_INSTALL_PACKAGES",
        "POST_NOTIFICATIONS"
      ],
      "backgroundColor": "#0b1f3a",
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#18b6b0"
        }
      ],
      "expo-secure-store",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DaraMarket",
              "label": "دارا — قیمت‌های بازار",
              "description": "قیمت‌های منتخب نمای بازار روی صفحه‌ی اصلی گوشی",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "backgroundColor": "#0b1f3a",
    "splash": {
      "backgroundColor": "#0b1f3a",
      "resizeMode": "contain"
    },
    "extra": {
      "build": 0
    }
  }
}
