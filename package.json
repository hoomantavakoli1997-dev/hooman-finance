{
  "name": "hooman-finance",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "test": "tsx --test src/core/*.test.ts",
